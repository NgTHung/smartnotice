    $("export-notes").addEventListener("click",()=>{const entries=groups.filter(g=>notes[g.group_id]).map(g=>({group_id:g.group_id,...notes[g.group_id]}));if(!entries.length){toast("Bạn chưa ghi chú nhóm nào. Chọn trạng thái hoặc thêm ghi chú trước khi xuất.");return;}const payload={kind:"local_group_review_notes",draft:true,assembly_fingerprint:DATA.assembly_fingerprint,exported_at:new Date().toISOString(),entries};const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="smartnotice-group-review-notes.json";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast("Đã xuất ghi chú. Các bản ghi nguồn vẫn giữ nguyên.");});

8px 0 18px}.sidebar-heading h2{font-size:17px;letter-spacing:-.3px}.count{font-size:11px;border:1px solid var(--line);border-radius:5px;padding:1px 6px;color:var(--muted)}.search-wrap{position:relative}.search-wrap svg{position:absolute;left:11px;top:13px;color:var(--muted)}#search{width:100%;border:1px solid var(--line);background:white;border-radius:8px;padding:10px 11px 10px 34px;outline-offset:1px;font-size:12px;color:var(--ink)}#search::placeholder{color:#8c9994}.filters{display:flex;padding:3px;background:#edf2ef;border-radius:7px;margin-top:13px;gap:3px}.filters button{width:50%;font-size:11px;padding:6px;border-radius:5px;color:var(--muted)}.filters button[aria-pressed=true]{background:white;color:var(--green);box-shadow:0 1px 4px #173d2b0c;font-weight:650}.list-caption{padding:0 21px 10px;font-size:11px;color:var(--muted)}#group-list{overflow:auto;flex:1;padding:0 11px 18px}.group-button{display:block;text-align:left;width:100%;border:1px solid transparent;border-radius:9px;padding:13px 12px;margin-bottom:5px;position:relative}.group-button:hover{background:#eef4f0}.group-button[aria-current=true]{background:var(--soft);border-color:#bdd9cc}.group-button[aria-current=true]:before{content:"";position:absolute;left:-1px;top:17px;bottom:17px;width:3px;border-radius:2px;background:var(--green)}.group-top{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:5px}.group-index{font:10px ui-monospace,Consolas,monospace;color:var(--muted);letter-spacing:.6px}.group-name{font-size:12px;font-weight:600;line-height:1.65;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.group-meta{font-size:10px;color:var(--muted);margin-top:7px;display:flex;gap:9px;align-items:center}.badge{font-size:10px;padding:3px 7px;border-radius:5px;display:inline-flex;gap:5px;align-items:center;background:#edf2ef;color:#5b7268;white-space:nowrap;font-weight:600}.badge.update{background:#fcf0dc;color:var(--gold)}.badge.ai{background:#eff0f9;color:#6c66a2}.badge.danger{background:#f9e8e4;color:#ad624d}.sidebar-bottom{padding:14px 21px;border-top:1px solid var(--line);font-size:10px;color:var(--muted);display:flex;align-items:center;gap:8px}.sidebar-bottom .dot{background:#b7c6be}main{overflow:auto;min-width:0}.main-inner{max-width:1660px;margin:auto;padding:25px 32px 40px}.overview{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;gap:20px}.overview-metrics{display:flex;gap:24px;flex-wrap:wrap}.metric{color:var(--muted);font-size:11px}.metric strong{font-size:19px;font-weight:700;color:var(--ink);margin-right:5px;letter-spacing:-.5px}.dataset-date{font-size:11px;color:var(--muted)}.group-head{display:flex;justify-content:space-between;gap:25px;align-items:flex-start}.heading-copy{min-width:0;max-width:900px}.heading-badges{display:flex;gap:7px;margin:10px 0 12px;flex-wrap:wrap}h1{font-size:27px;line-height:1.35;font-weight:650;letter-spacing:-.8px;text-wrap:balance}.subtitle{font-size:12px;color:var(--muted);margin-top:11px}.group-nav{display:flex;gap:7px;margin-top:6px}.group-nav button{padding:8px 12px;font-size:16px}.tabs{display:flex;gap:23px;border-bottom:1px solid var(--line);margin-top:27px;margin-bottom:20px}.tabs button{padding:0 0 12px;font-size:12px;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap}.tabs button[aria-selected=true]{border-color:var(--green);font-weight:650;color:var(--green)}.tabs .tab-count{margin-left:5px;font-size:10px;opacity:.7}.panel{min-height:300px}.section-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:0 0 15px}.section-heading{font-size:12px;font-weight:650}.legend{display:flex;gap:13px;align-items:center;color:var(--muted);font-size:10px;flex-wrap:wrap}.legend-item{display:flex;gap:5px;align-items:center}.swatch{width:9px;height:9px;border-radius:3px;background:#e0f1e8}.swatch.time{background:#f8e8b4}.swatch.condition{background:#ece4fb}.swatch.audience{background:#e0eaf9}.highlight-control{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:7px}.highlight-control input{accent-color:var(--green)}.email-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,365px),1fr));gap:17px;align-items:start}.email-card{background:var(--paper);border:1px solid var(--line);border-radius:11px;overflow:hidden;min-width:0;box-shadow:var(--shadow)}.email-card-head{padding:17px 19px 14px;border-bottom:1px solid #edf1ee}.email-topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;gap:8px}.email-number{font-size:11px;color:var(--green);font-weight:650;display:flex;gap:8px;align-items:center}.mail-icon{width:27px;height:27px;display:grid;place-items:center;border:1px solid var(--line);border-radius:7px;background:#fafcfb}.source-date{font-size:11px;color:var(--muted)}.email-title{font-size:12px;line-height:1.6;font-weight:600;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.email-body{padding:20px;white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal;font-size:13px;line-height:1.85;color:#40534b;max-height:64vh;overflow:auto;scrollbar-width:thin}.email-foot{padding:10px 19px;border-top:1px solid #edf1ee;background:#fcfdfc;color:var(--muted);font-size:10px}.email-foot details{cursor:pointer}.email-foot code{display:block;font-size:10px;overflow-wrap:anywhere;padding-top:7px}.mark{border-radius:3px;padding:1px 0;box-decoration-break:clone;-webkit-box-decoration-break:clone}.mark.ACTION{background:#e0f1e8;color:#245d46;font-weight:600}.mark.TIME{background:#fcf0c9;color:#80601f}.mark.CONDITION{background:#efe7fa;color:#745294}.mark.AUDIENCE{background:#e7eef9;color:#48668a}.mark.DOCUMENT,.mark.CHANNEL{background:#f0f3f1}.focus-source{outline:2px solid #c28833;background:#fff0b5!important;scroll-margin:120px}.reading-tip{display:flex;gap:8px;align-items:flex-start;margin-top:17px;font-size:11px;color:var(--muted)}.update-banner{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 18px;background:#fbf6ea;border:1px solid #e9debf;border-radius:9px;margin-bottom:18px}.update-banner .update-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gold);font-weight:700}.update-banner .update-line{font-size:12px;color:#725b35;margin-top:3px}.old-value{text-decoration:line-through;opacity:.65}.arrow{margin:0 9px;color:var(--muted)}.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:20px;margin-bottom:15px;box-shadow:var(--shadow)}.card-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:15px}.card-title{font-size:14px;font-weight:650;line-height:1.6}.card-kicker{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}.fact-row{display:grid;grid-template-columns:135px minmax(0,1fr);gap:15px;padding:11px 0;border-top:1px solid #eef2ef;font-size:12px}.fact-label{color:var(--muted);font-size:11px}.fact-content{white-space:pre-wrap;overflow-wrap:anywhere}.fact-content button{color:var(--green);font-size:10px;margin-left:8px;text-decoration:underline;text-underline-offset:3px}.history{margin-top:12px;border-top:1px solid var(--line);padding-top:13px;font-size:11px;color:var(--muted)}.history summary{cursor:pointer}.history-item{margin-top:9px;font-size:12px}.review-explanation{font-size:13px;line-height:1.85;color:#52645c;margin-top:7px}.review-pair{font-size:10px;color:var(--muted);margin-bottom:10px}.evidence{border-left:2px solid #d5e5dc;background:#f7faf8;border-radius:0 7px 7px 0;padding:13px 15px;margin:12px 0 0;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}.evidence-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:10px;color:var(--muted);margin-top:9px}.text-button{font-size:11px;color:var(--green);padding:0;text-decoration:underline;text-underline-offset:3px}.note-card{margin-top:24px;padding:18px 20px;background:#eef4f0;border:1px solid #dbe7df;border-radius:9px}.note-header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.note-header h2{font-size:12px;font-weight:650}.save-status{font-size:10px;color:var(--muted)}.review-statuses{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.review-statuses button{padding:5px 10px;border-radius:6px;font-size:11px;border:1px solid #d9e3dd;background:#fff;color:var(--muted)}.review-statuses button[aria-pressed=true]{background:var(--green);border-color:var(--green);color:#fff}#note{width:100%;min-height:75px;resize:vertical;border:1px solid #d6e1d9;border-radius:7px;background:#fff;padding:11px 12px;font-size:12px;color:var(--ink)}.note-help{margin-top:7px;font-size:10px;color:var(--muted)}.empty{padding:45px 15px;text-align:center;color:var(--muted);font-size:12px}.toast{position:fixed;right:24px;bottom:24px;z-index:10;background:var(--ink);color:white;padding:13px 18px;font-size:12px;border-radius:9px;box-shadow:0 8px 35px #173b3520;max-width:380px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .feedback-card{margin-top:18px;padding:14px 17px;border:1px solid #cfe1d6;border-radius:9px;background:#f3f9f5;font-size:12px;color:#476555}.feedback-card h2{font-size:12px;margin-bottom:7px;color:#245b42}.feedback-card p+p{margin-top:7px}.source-gap{display:block;padding:6px 0;color:#8b9991;font-size:10px;font-style:italic;white-space:normal}.mark.EVIDENCE{background:#eff6f1;border-bottom:1px dotted #91b09c}.context-control{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted)}.source-controls{display:flex;gap:14px;flex-wrap:wrap}
    @media(min-width:1700px){.main-inner{padding-left:45px;padding-right:45px}}@media(max-width:1000px){.workspace{grid-template-columns:250px minmax(0,1fr)}.sidebar-top{padding-left:16px;padding-right:16px}.main-inner{padding:22px}.overview-metrics{gap:15px}.dataset-date{display:none}h1{font-size:24px}.brand-sub{display:none}.fact-row{grid-template-columns:110px minmax(0,1fr)}}@media(max-width:700px){.topbar{height:65px;padding:0 17px}.brand-name{font-size:17px}.brand-mark{width:32px;height:32px}.top-actions{gap:8px}.local-label{display:none}.workspace{height:auto;display:block}.sidebar{border-right:0;border-bottom:1px solid var(--line)}.sidebar-top{padding:16px 17px 12px}.sidebar-heading{margin:0 0 10px}.sidebar-top .eyebrow{display:none}.filters{margin-top:9px}#group-list{max-height:205px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:0 10px 10px;gap:3px}.group-button{margin:0;padding:10px}.sidebar-bottom{display:none}.list-caption{font-size:10px;padding-bottom:5px}.main-inner{padding:20px 17px 35px}.overview{margin-bottom:23px}.overview-metrics{gap:15px}.metric{font-size:10px}.metric strong{font-size:17px}.group-head{gap:10px}.group-nav button{padding:6px 9px}h1{font-size:22px}.tabs{gap:18px;overflow:auto;margin-top:22px}.tabs button{font-size:11px}.email-grid{grid-template-columns:minmax(0,1fr)}.email-body{max-height:65vh}.section-toolbar{align-items:flex-start}.legend{gap:8px;font-size:9px}.fact-row{grid-template-columns:95px minmax(0,1fr);gap:10px}.note-header{align-items:flex-start}.update-banner{align-items:flex-start}.update-banner>.badge{display:none}}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand"><div class="brand-mark" aria-hidden="true">SN</div><span class="brand-name">SmartNotice<span style="color:#78a18d">.</span></span><span class="brand-sub">Không gian duyệt dữ liệu</span></div>
    <div class="top-actions"><span class="local-label"><span class="dot"></span>Chạy hoàn toàn cục bộ</span><button class="button" id="export-notes">Xuất ghi chú <span aria-hidden="true">↗</span></button></div>
  </header>
  <div class="workspace">
    <aside class="sidebar" aria-label="Danh sách nhóm sự kiện">
      <div class="sidebar-top">
        <div class="eyebrow">Đối chiếu nguồn</div><div class="sidebar-heading"><h2>Nhóm sự kiện</h2><span class="count" id="all-count"></span></div>
        <div class="search-wrap"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><label class="sr-only" for="search">Tìm nhóm hoặc nội dung email</label><input id="search" type="search" placeholder="Tìm nhóm hoặc nội dung email…" autocomplete="off"></div>
        <div class="filters" aria-label="Lọc nhóm"><button id="multi-filter" aria-pressed="true">Nhiều email</button><button id="all-filter" aria-pressed="false">Tất cả nhóm</button></div>
      </div>
      <div class="list-caption" id="list-count" aria-live="polite"></div><nav id="group-list" aria-label="Chọn nhóm"></nav>
      <div class="sidebar-bottom"><span class="dot"></span>Bản đề xuất AI · Chưa duyệt riêng tư</div>
    </aside>
    <main id="main"><div class="main-inner">
      <div class="overview"><div class="overview-metrics" id="metrics"></div><span class="dataset-date">Bản đối chiếu cục bộ</span></div>
      <div id="group-content"></div>
    </div></main>
  </div>
  <div id="announcement" class="sr-only" aria-live="polite"></div>
  <script type="application/json" id="review-data">__SMARTNOTICE_REVIEW_DATA__</script>
  <script>
    "use strict";
    const DATA = JSON.parse(document.getElementById("review-data").textContent);
    const ASSEMBLY = DATA.assembly;
    const notices = new Map(DATA.notices.map(n => [n.doc_id, n]));
    const mentions = new Map(ASSEMBLY.mentions.map(m => [m.version.event_ref, m]));
    const docId = ref => ref.split(":")[0];
    const actionText = ref => {const m=mentions.get(ref);return m.spans.find(s=>s.span_id===m.event.action_span_id).text;};
    const fold = text => text.toLocaleLowerCase("vi").normalize("NFD").replace(/\p{M}/gu,"").replace(/đ/g,"d");
    const dateText = value => value ? value.split("-").reverse().join("/") : "Chưa có ngày nguồn";
    const fieldLabels = {START:"Bắt đầu",END:"Kết thúc",DEADLINE:"Hạn thực hiện",EVENT_TIME:"Thời gian diễn ra",AUDIENCE:"Đối tượng",CONDITION:"Điều kiện",CHANNEL:"Kênh thực hiện",DOCUMENT:"Tài liệu",LOCATION:"Địa điểm",STATUS:"Trạng thái"};
    const decisions = {SAME_EVENT:"Cùng nhóm",UPDATE_OF:"Bản cập nhật",DIFFERENT_EVENT:"Khác nhóm",UNCLEAR:"Chưa rõ"};
    const relations = {SAME_TASK:"Cùng đầu việc",DIFFERENT_TASK:"Khác đầu việc",DIFFERENT_SESSION:"Khác phiên",CONDITIONAL_TASK:"Việc phát sinh theo điều kiện",UNRESOLVED:"Chưa chốt quan hệ đầu việc"};
    const noteStatuses = {not_seen:"Chưa xem",looks_ok:"Tạm đồng ý",needs_check:"Cần kiểm tra",suggest_split:"Đề nghị tách"};
    const feedbackByGroup = new Map((DATA.applied_feedback || []).map(item => [item.group_id, item]));
    const displayLabels = new Map((DATA.display_labels?.labels || []).map(item => [item.group_id, item.title]));
    const groups = ASSEMBLY.groups.map((group,index)=>{
      const titles=group.tasks.map(t=>[...t.members].sort((a,b)=>actionText(b).length-actionText(a).length).map(actionText)[0]);
      let title=[...titles].sort((a,b)=>b.length-a.length)[0] || "Nhóm sự kiện";
      if(group.tasks.length===1){const heading=group.members.flatMap(ref=>mentions.get(ref).sentences).find(s=>/^\s*(?:\d+\.\s*)?CHUYÊN ĐỀ\s+\d+\s*:/i.test(s.text));if(heading)title=heading.text.replace(/^\s*\d+\.\s*/,"");}
      title=displayLabels.get(group.group_id)||title;
      const reviews=ASSEMBLY.reviews.filter(r=>group.members.includes(r.left.event_ref)||group.members.includes(r.right.event_ref));
      const updates=reviews.filter(r=>r.decision==="UPDATE_OF"&&group.members.includes(r.left.event_ref)&&group.members.includes(r.right.event_ref));
      return {...group,index:index+1,title,reviews,updates,feedback:feedbackByGroup.get(group.group_id)||null,search:fold([title,group.group_id,...group.document_ids.map(id=>notices.get(id).text)].join(" "))};
    });
    const groupMap=new Map(groups.map(g=>[g.group_id,g]));
    const storageKey="smartnotice-group-notes:"+DATA.assembly_fingerprint;
    let notes={},storageAvailable=true;
    try{const stored=JSON.parse(localStorage.getItem(storageKey)||"{}");if(stored&&typeof stored==="object"&&!Array.isArray(stored))notes=stored;}catch{storageAvailable=false;}
    const state={multi:false,context:false,query:"",tab:"emails",highlight:true,focus:null,selected:null};
    const fromHash=location.hash.slice(1);
    state.selected=groupMap.has(fromHash)?fromHash:(groups.find(g=>g.updates.length)?.group_id||groups[0]?.group_id);
    if(state.selected&&groupMap.get(state.selected).document_ids.length<2)state.multi=false;
    const $=id=>document.getElementById(id);
    function el(tag,className,text){const node=document.createElement(tag);if(className)node.className=className;if(text!==undefined)node.textContent=text;return node;}
    function button(text,fn,className="button"){const b=el("button",className,text);b.type="button";b.addEventListener("click",fn);return b;}
    function badge(text,kind=""){return el("span","badge "+kind,text);}
    function toast(text){document.querySelector(".toast")?.remove();const n=el("div","toast",text);n.setAttribute("role","status");document.body.append(n);setTimeout(()=>n.remove(),4200);}
    function visibleGroups(){return groups.filter(g=>(!state.multi||g.document_ids.length>1)&&(!state.query||g.search.includes(fold(state.query))));}
    function noteFor(group){const n=notes[group.group_id],f=group.feedback;if(f&&noteStatuses[f.status]&&(!n?.updated_at||Date.parse(n.updated_at)<=Date.parse(f.updated_at)))return {status:f.status,text:n?.text||"",updated_at:f.updated_at};return n&&typeof n==="object"?n:{status:"not_seen",text:""};}
    function saveNote(group,patch){const previous=noteFor(group);notes[group.group_id]={status:previous.status||"not_seen",text:previous.text||"",...patch,updated_at:new Date().toISOString()};try{localStorage.setItem(storageKey,JSON.stringify(notes));storageAvailable=true;}catch{storageAvailable=false;}const status=$("save-status");if(status)status.textContent=storageAvailable?"Đã lưu trên trình duyệt":"Chỉ giữ trong phiên này";renderList();}
    function sourceTitle(notice){const lines=notice.text.split("\n").map(s=>s.trim()).filter(Boolean);return lines.find(s=>s.length>20&&!/^(chào|thân chào|mến gửi|mến chào|kính chào|dear students|https?:|[-_]{3})/i.test(s))||lines[0]||"Email nguồn";}
    function renderMetrics(){const entries=[[groups.length,"nhóm"],[groups.filter(g=>g.document_ids.length>1).length,"nhóm nhiều email"],[notices.size,"email"],[groups.reduce((n,g)=>n+g.tasks.length,0),"hoạt động / đầu việc"]];$("metrics").replaceChildren(...entries.map(([value,label])=>{const n=el("div","metric");n.append(el("strong","",String(value)),document.createTextNode(label));return n;}));$("all-count").textContent=String(groups.length);}
    function renderList(){const filtered=visibleGroups();$("list-count").textContent=`${filtered.length} nhóm phù hợp`;$("multi-filter").setAttribute("aria-pressed",String(state.multi));$("all-filter").setAttribute("aria-pressed",String(!state.multi));const nodes=filtered.map(group=>{const b=button("",()=>selectGroup(group.group_id),"group-button");b.setAttribute("aria-current",String(group.group_id===state.selected));b.setAttribute("aria-label",`${group.title}, ${group.document_ids.length} email`);const top=el("div","group-top");top.append(el("span","group-index","NHÓM "+String(group.index).padStart(2,"0")));if(group.updates.length)top.append(badge("Có cập nhật","update"));else if(noteFor(group).status&&noteFor(group).status!=="not_seen")top.append(badge(noteStatuses[noteFor(group).status]||"Đã ghi chú"));if(group.feedback)top.append(badge(group.feedback.outcome==="merged"?"Đã gộp theo góp ý":group.feedback.status==="looks_ok"?"Đã đồng ý nhóm":"Góp ý đã áp dụng"));b.append(top,el("div","group-name",group.title));const meta=el("div","group-meta");meta.append(el("span","",`${group.document_ids.length} email`),el("span","","·"),el("span","",`${group.tasks.length} hoạt động / đầu việc`));b.append(meta);return b;});$("group-list").replaceChildren(...(nodes.length?nodes:[el("div","empty","Không có nhóm phù hợp. Thử từ khóa khác hoặc xem tất cả nhóm.")]));}
    function selectGroup(id){if(!groupMap.has(id))return;state.selected=id;state.focus=null;try{history.replaceState(null,"","#"+id);}catch{}renderList();renderGroup();$("main").scrollTop=0;$("announcement").textContent="Đã mở nhóm: "+groupMap.get(id).title;}
    function showQuote(q,ref){if(ref){const target=groups.find(g=>g.members.includes(ref));if(target&&target.group_id!==state.selected){state.selected=target.group_id;state.multi=false;state.query="";$("search").value="";}}state.focus=q;state.tab="emails";renderList();renderGroup();requestAnimationFrame(()=>document.querySelector(".focus-source")?.scrollIntoView({behavior:"smooth",block:"center"}));}
    function markedText(notice, group) {
      const container = el("div", "email-body");
      container.dataset.docId = notice.doc_id;
      const chars = Array.from(notice.text);
      const local = group.members.filter(ref => docId(ref) === notice.doc_id).map(ref => mentions.get(ref));
      const evidence = group.reviews.filter(r => ["SAME_EVENT","UPDATE_OF"].includes(r.decision) && group.members.includes(r.left.event_ref) && group.members.includes(r.right.event_ref)).flatMap(r => r.evidence).filter(q => q.doc_id === notice.doc_id);
      const spans = state.highlight ? local.flatMap(m => m.spans).concat(evidence.filter(q => Array.from(q.text).length < 145).map(q => ({...q, label:"EVIDENCE"}))) : [];
      const focus = state.focus?.doc_id === notice.doc_id ? state.focus : null;
      const rawRanges = state.context ? [{start:0,end:chars.length}] : local.flatMap(m => m.sentences).concat(evidence);
      if(focus) rawRanges.push(focus);
      const ranges = [];
      for(const range of rawRanges.slice().sort((a,b) => a.start-b.start)) {
        const previous = ranges[ranges.length-1];
        const gap = previous ? chars.slice(previous.end,range.start).join("") : "";
        if(previous && (range.start <= previous.end || (range.start-previous.end <= 4 && !gap.trim()))) {
          previous.end = Math.max(previous.end,range.end);
        } else ranges.push({start:range.start,end:range.end});
      }
      const points = new Set([0, chars.length]);
      for(const range of spans.concat(ranges)) { points.add(range.start); points.add(range.end); }
      if(focus) { points.add(focus.start); points.add(focus.end); }
      const cuts = [...points].filter(n => n >= 0 && n <= chars.length).sort((a,b) => a-b);
      const priority = {ACTION:0,TIME:1,CONDITION:2,AUDIENCE:3,DOCUMENT:4,CHANNEL:5,EVIDENCE:6};
      let omitted = false;
      for(let i=0; i<cuts.length-1; i++) {
        const start = cuts[i], end = cuts[i+1];
        const visible = ranges.some(r => r.start < end && r.end > start);
        if(!visible) {
          if(!omitted) container.append(el("span", "source-gap", "… Phần khác của email đã ẩn …"));
          omitted = true;
          continue;
        }
        omitted = false;
        const active = spans.filter(r => r.start < end && r.end > start).sort((a,b) => priority[a.label]-priority[b.label]);
        const isFocus = focus && focus.start < end && focus.end > start;
        const text = chars.slice(start,end).join("");
        if(active.length || isFocus) {
          const mark = el("span", "mark " + (active[0]?.label || "") + (isFocus ? " focus-source" : ""), text);
          mark.title = [...new Set(active.map(r => r.label))].join(" ? ");
          container.append(mark);
        } else container.append(document.createTextNode(text));
      }
      return container;
    }
    function renderEmails(group){const panel=el("section","panel");const toolbar=el("div","section-toolbar");const legend=el("div","legend");for(const [cls,text] of [["","Hoạt động / đầu việc"],["time","Thời gian"],["condition","Điều kiện"],["audience","Đối tượng"]]){const item=el("span","legend-item");item.append(el("i","swatch "+cls),document.createTextNode(text));legend.append(item);}const label=el("label","highlight-control");const check=document.createElement("input");check.type="checkbox";check.checked=state.highlight;check.id="highlight-toggle";check.addEventListener("change",()=>{state.highlight=check.checked;renderGroup();});label.append(check,document.createTextNode("Đánh dấu trích xuất"));const controls=el("div","source-controls");const contextLabel=el("label","context-control");const contextCheck=document.createElement("input");contextCheck.type="checkbox";contextCheck.id="context-toggle";contextCheck.checked=state.context;contextCheck.addEventListener("change",()=>{state.context=contextCheck.checked;renderGroup();});contextLabel.append(contextCheck,document.createTextNode("Hiện toàn bộ email"));controls.append(label,contextLabel);toolbar.append(legend,controls);panel.append(toolbar);for(const update of group.updates){for(const change of update.changes){const banner=el("div","update-banner");const copy=el("div");copy.append(el("div","update-label","Đã có bản cập nhật · "+(fieldLabels[change.field]||change.field)));const values=el("div","update-line");values.append(el("span","old-value",change.old?.text||"Chưa xác định giá trị cũ"),el("span","arrow","→"),el("strong","",change.new.text));copy.append(values);banner.append(copy,badge("Giữ lịch sử cũ","update"));panel.append(banner);}}
      const grid=el("div","email-grid");const docs=group.document_ids.map(id=>notices.get(id)).sort((a,b)=>(a.reference_date||"9999").localeCompare(b.reference_date||"9999")||a.doc_id.localeCompare(b.doc_id));docs.forEach((notice,index)=>{const card=el("article","email-card");const head=el("header","email-card-head");const line=el("div","email-topline");const number=el("span","email-number");number.append(el("span","mail-icon","✉"),document.createTextNode("Email "+String(index+1).padStart(2,"0")));line.append(number,el("span","source-date",dateText(notice.reference_date)));head.append(line,el("h2","email-title",group.members.filter(ref=>docId(ref)===notice.doc_id).map(actionText).join(" ? ")));const foot=el("footer","email-foot");const details=document.createElement("details");details.append(el("summary","","Văn bản đã chuẩn bị · Thông tin nguồn"),el("code","",notice.doc_id));foot.append(details);card.append(head,markedText(notice,group),foot);grid.append(card);});panel.append(grid,el("p","reading-tip","Đang xem các đoạn liên quan đến mục trong nhóm. Bật “Hiện toàn bộ email” để đọc toàn văn. Một email có thể chứa các mục thuộc nhiều nhóm."));return panel;}
    function renderTasks(group){const panel=el("section","panel");group.tasks.forEach((task,index)=>{const card=el("article","card");const head=el("div","card-head");const names=[...new Set(task.members.map(actionText))];const title=el("div");title.append(el("div","card-kicker",`Hoạt động / đầu việc ${index+1}`),el("h2","card-title",names[0]));head.append(title,badge(`${task.members.length} lần nhắc`));card.append(head);const byId=new Map(task.facts.map(f=>[f.fact_id,f]));let hasTime=false;for(const [field,ids] of Object.entries(task.active_values)){if(["START","END","DEADLINE","EVENT_TIME"].includes(field))hasTime=true;const row=el("div","fact-row");const value=el("div","fact-content");const shown=new Set();for(const id of ids){const fact=byId.get(id);if(shown.has(fact.quote.text))continue;shown.add(fact.quote.text);const item=el("div","",fact.quote.text);item.append(button("Xem nguồn",()=>showQuote(fact.quote,fact.mention_ref),""));value.append(item);}row.append(el("div","fact-label",fieldLabels[field]||field),value);card.append(row);}if(!hasTime)card.append(el("p","reading-tip","Chưa có mốc thời gian được trích xuất cho đầu việc này."));const old=task.facts.filter(f=>f.superseded_by.length);if(old.length){const history=el("details","history");history.append(el("summary","",`Lịch sử: ${old.length} giá trị đã được thay thế`));for(const fact of old){const item=el("div","history-item");item.append(el("span","old-value",fact.quote.text),el("span","arrow","→"),document.createTextNode(fact.superseded_by.map(id=>byId.get(id)?.quote.text||id).join(" / ")));history.append(item);}card.append(history);}panel.append(card);});return panel;}
    function evidenceTarget(review, quote) {
      const refs = [review.left.event_ref, review.right.event_ref].filter(ref => docId(ref) === quote.doc_id);
      const score = ref => mentions.get(ref).spans.reduce((n,span) => n + (span.start < quote.end && span.end > quote.start ? (span.label === "ACTION" ? 100 : 5) : 0), 0);
      return refs.sort((a,b) => score(b)-score(a))[0] || review.left.event_ref;
    }
    function renderReasons(group){const panel=el("section","panel");if(!group.reviews.length){panel.append(el("div","card","Chưa có quyết định cặp cho nhóm đơn này. Việc giữ riêng không tự xác nhận đây là một sự kiện độc lập."));return panel;}for(const review of group.reviews){const card=el("article","card");const head=el("div","card-head");const copy=el("div");copy.append(el("div","card-kicker",`Cặp ${review.review_id.toUpperCase()}`),el("h2","card-title",relations[review.task_relation]));head.append(copy,badge(decisions[review.decision],review.decision==="UPDATE_OF"?"update":review.decision==="DIFFERENT_EVENT"?"danger":""));card.append(head,el("div","review-pair",actionText(review.left.event_ref)+" ↔ "+actionText(review.right.event_ref)),el("p","review-explanation",review.rationale));const author=el("p","reading-tip",`Đề xuất của ${review.author.reviewer_kind==="ai_assistant"?"trợ lý AI":"người duyệt"} · ${review.author.reviewer_id}`);card.append(author);for(const q of review.evidence){const evidence=el("div","evidence");evidence.append(document.createTextNode(q.text));const footer=el("div","evidence-footer");const ref=evidenceTarget(review,q);footer.append(el("span","",`Nguồn ${q.doc_id.slice(0,8)}… · ${q.sentence_id}`),button("Xem trong email",()=>showQuote(q,ref),"text-button"));evidence.append(footer);card.append(evidence);}panel.append(card);}return panel;}
    function renderNote(group){const card=el("section","note-card");const header=el("div","note-header");header.append(el("h2","","Ghi chú bổ sung cho bản kết quả này"));const saved=el("span","save-status",storageAvailable?"Lưu riêng trên trình duyệt":"Chỉ giữ trong phiên này");saved.id="save-status";header.append(saved);const controls=el("div","review-statuses");for(const [value,label] of Object.entries(noteStatuses)){const b=button(label,()=>{saveNote(group,{status:value});for(const other of controls.children)other.setAttribute("aria-pressed",String(other===b));},"");b.setAttribute("aria-pressed",String((noteFor(group).status||"not_seen")===value));controls.append(b);}const textarea=document.createElement("textarea");textarea.id="note";textarea.setAttribute("aria-label","Ghi chú đối chiếu nhóm đang xem");textarea.placeholder="Điểm đúng, bằng chứng còn thiếu hoặc đầu việc cần tách…";textarea.value=typeof noteFor(group).text==="string"?noteFor(group).text:"";textarea.addEventListener("input",()=>saveNote(group,{text:textarea.value}));card.append(header,controls,textarea,el("p","note-help","Ghi chú này không thay đổi annotation, quyết định cặp hoặc xác nhận riêng tư. Dùng “Xuất ghi chú” để lưu một bản sao."));return card;}
    function renderGroup(){const group=groupMap.get(state.selected);if(!group){$("group-content").replaceChildren(el("div","empty","Không có nhóm để hiển thị."));return;}const root=el("div");const head=el("div","group-head");const copy=el("div","heading-copy");copy.append(el("div","eyebrow",`Nhóm ${String(group.index).padStart(2,"0")} / ${groups.length}`));const badges=el("div","heading-badges");badges.append(badge(`${group.document_ids.length} email`),badge(`${group.tasks.length} hoạt động / đầu việc`),badge(group.feedback?(group.feedback.outcome==="merged"?"Đã gộp theo góp ý":group.feedback.status==="looks_ok"?"Đã đồng ý nhóm":"Đã áp dụng góp ý"):"Đề xuất AI",group.feedback?"":"ai"));copy.append(badges,el("h1","",group.title),el("p","subtitle","Đọc nguồn cạnh nhau để kiểm tra danh tính sự kiện, từng đầu việc và thông tin thay đổi."));const nav=el("div","group-nav");const visible=visibleGroups(),index=visible.findIndex(g=>g.group_id===group.group_id);for(const [step,text,label] of [[-1,"←","Nhóm trước"],[1,"→","Nhóm tiếp theo"]]){const b=button(text,()=>selectGroup(visible[index+step].group_id));b.setAttribute("aria-label",label);b.disabled=index<0||!visible[index+step];nav.append(b);}head.append(copy,nav);root.append(head);if(group.feedback){const f=group.feedback;const applied=el("section","feedback-card");applied.append(el("h2","",f.outcome==="merged"?"Nhóm đã được gộp theo góp ý":f.status==="looks_ok"?"Nhóm đã được đồng ý":"Góp ý của bạn đã được áp dụng"));if(f.text)applied.append(el("p","",f.text));applied.append(el("p","",f.rationale));root.append(applied);}const tabs=el("div","tabs");tabs.setAttribute("role","tablist");for(const [key,text,count] of [["emails","Email nguồn",group.document_ids.length],["tasks","Hoạt động & thời gian",group.tasks.length],["reasons","Lý do & bằng chứng",group.reviews.length]]){const b=button("",()=>{state.tab=key;renderGroup();},"");b.id="tab-"+key;b.setAttribute("role","tab");b.setAttribute("aria-selected",String(state.tab===key));b.setAttribute("aria-controls","review-panel");b.append(document.createTextNode(text),el("span","tab-count",String(count)));tabs.append(b);}root.append(tabs);const panel=state.tab==="tasks"?renderTasks(group):state.tab==="reasons"?renderReasons(group):renderEmails(group);panel.id="review-panel";panel.setAttribute("role","tabpanel");panel.setAttribute("aria-labelledby","tab-"+state.tab);root.append(panel,renderNote(group));$("group-content").replaceChildren(root);}
    $("search").addEventListener("input",event=>{state.query=event.target.value;renderList();});
